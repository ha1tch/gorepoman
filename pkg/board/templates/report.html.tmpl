{{range .Projects}}
<div style="margin-bottom:1.25rem;">
<p style="font-size:14px;font-weight:600;margin:0 0 4px;">{{.Name}} <span style="font-weight:400;color:var(--text-3);font-size:12px;">{{.Path}}</span></p>
{{if .RegisterError}}<p style="font-size:12px;color:var(--text-2);margin:0 0 4px;">register: {{.RegisterError}}</p>
{{else if not .OpenItems}}<p style="font-size:12px;color:var(--text-2);margin:0 0 4px;">register: no open items</p>
{{else}}<div style="display:flex;flex-direction:column;">
{{range .OpenItems}}
<div style="display:grid;grid-template-columns:60px 26px 32px 110px 1fr;gap:10px;align-items:center;padding:4px 0;border-bottom:1px solid var(--border);font-size:12px;">
  <span style="font-weight:600;">{{.ID}}</span><span>{{.Status}}</span><span style="color:var(--text-2);">{{.Priority}}</span><span style="color:var(--text-2);">{{.Theme}}</span><span>{{.Title}}</span>
</div>
{{end}}
</div>{{end}}
{{if .WaveError}}<p style="font-size:11px;color:var(--text-3);margin:6px 0 0;">waves: {{.WaveError}}</p>
{{else}}<p style="font-size:11px;color:var(--text-3);margin:6px 0 0;">waves: {{.WaveOverallPct}}% overall</p>{{end}}
</div>
{{end}}
